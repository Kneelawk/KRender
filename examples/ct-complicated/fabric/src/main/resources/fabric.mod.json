{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    ${authors_fabric}
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}",
    "sources": "${sources}"
  },
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "${environment}",
  "entrypoints": {
    "main": [
      {
        "value": "com.kneelawk.krender.ctcomplicated.fabric.FabricMod"
      }
    ],
    "client": [
      {
        "value": "com.kneelawk.krender.ctcomplicated.fabric.FabricClientMod"
      }
    ]
  },
  "mixins": [ ],
  "depends": {
    "fabric-api": "*",
    "fabricloader": "${loader_version_fabric}",
    "minecraft": "${mc_version_fabric}",
    "java": "${java_version_fabric}",
    "krender_model_loading": "*",
    "krender_engine_api": "*"
  }
}
